{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "lokka-069",
          "appId": "1:715791241789:android:11e90b85d6f9980ffd9054",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "lokka-069",
          "configurations": {
            "android": "1:715791241789:android:11e90b85d6f9980ffd9054"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "comment": "Entry/shell files must ALWAYS revalidate. This is the real root-cause fix for the 'I re-uploaded but the browser still runs old code' bug — proper cache headers, not a blanket service-worker unregister.",
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/@(flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|manifest.json|version.json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "comment": "Deferred-import chunks (e.g. main.dart.js_1.part.js) are not content-hashed by the Flutter build → must revalidate so a redeploy can't serve a stale chunk.",
        "source": "**/*.part.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "comment": "Self-hosted Firebase SDK is version-pinned in the import map → safe to cache hard.",
        "source": "/firebase/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "comment": "Static, content-stable assets — long immutable cache for fast repeat loads. (json deliberately excluded: root manifest/version json must revalidate.)",
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|otf|wasm)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "comment": "CanvasKit + Flutter asset bundles are content-addressed by the build.",
        "source": "/@(canvaskit|assets)/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Lokka - Local Deals & Loyalty",
        "supportEmail": "nabell.321@gmail.com"
      }
    }
  }
}
