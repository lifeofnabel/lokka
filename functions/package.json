{
  "name": "lokka-functions",
  "description": "Lokka Cloud Functions — Stempelkarten (stamp cards) security core",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node test/selfTest.js",
    "derive-keys": "npm run build && node lib/scripts/deriveKeys.js"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "typescript": "5.5.4"
  }
}
